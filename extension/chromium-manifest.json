{
  "manifest_version": 3,
  "name": "Omarchy Apple Music",
  "version": "0.2.0",
  "description": "Adds an Omarchy-themed compact player, live system spectrum, and full-view switch to music.apple.com.",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://music.apple.com/*"
      ],
      "js": [
        "player-model.js",
        "player-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://music.apple.com/*"
      ],
      "css": [
        "content.css"
      ],
      "js": [
        "theme-model.js",
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "theme.json",
        "spectrum.json"
      ],
      "matches": [
        "https://music.apple.com/*"
      ]
    }
  ]
}
